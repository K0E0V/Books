@page "{id:int}"
@model Books.Pages.Books.DetailsModel
@{
    ViewData["Title"] = Model.Book?.Title ?? "Книга";
}

<link rel="stylesheet" href="~/css/book-form.css" asp-append-version="true" />

<h1 class="h4 mb-3">@Model.Book?.Title</h1>

<!-- Закладки: видны только на мобильных. На десктопе обе панели рядом -->
<ul class="nav nav-tabs d-lg-none mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" type="button" role="tab"
                data-bs-toggle="tab" data-bs-target="#pane-requisites">
            Реквизиты
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" type="button" role="tab"
                data-bs-toggle="tab" data-bs-target="#pane-contents">
            Оглавление
        </button>
    </li>
</ul>

<div class="tab-content blocks-tabs">

    <!-- Панель: Реквизиты книги -->
    <div class="tab-pane fade show active pane-wide" id="pane-requisites" role="tabpanel">
        <div class="card mb-3">
            <div class="card-header block-header">
                <span class="block-title">Реквизиты книги</span>
            </div>
            <div class="card-body py-2">
                <dl class="row mb-0 small" style="font-size: 0.85rem;">
                    <dt class="col-sm-4 col-form-label py-1">Автор:</dt>
                    <dd class="col-sm-8 py-1">@Model.Book?.Author</dd>

                    <dt class="col-sm-4 col-form-label py-1">Год издания:</dt>
                    <dd class="col-sm-8 py-1">@Model.Book?.PublicationYear</dd>

                    <dt class="col-sm-4 col-form-label py-1">ISBN:</dt>
                    <dd class="col-sm-8 py-1">@(Model.Book?.Isbn ?? "—")</dd>

                    <dt class="col-sm-4 col-form-label py-1">Количество страниц:</dt>
                    <dd class="col-sm-8 py-1">@Model.Book?.CountPages</dd>

                    <dt class="col-sm-4 col-form-label py-1">Издательство:</dt>
                    <dd class="col-sm-8 py-1">@(Model.Book?.Publisher ?? "—")</dd>

                    <dt class="col-sm-4 col-form-label py-1">Жанры:</dt>
                    <dd class="col-sm-8 py-1">
                        @if (Model.Genres.Any())
                        {
                            foreach (var g in Model.Genres)
                            {
                                <span class="badge book-badge me-1">@g</span>
                            }
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </dd>

                    <dt class="col-sm-4 col-form-label py-1">Типы:</dt>
                    <dd class="col-sm-8 py-1">
                        @if (Model.BookTypes.Any())
                        {
                            foreach (var t in Model.BookTypes)
                            {
                                <span class="badge book-badge me-1">@t</span>
                            }
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </dd>

                    <dt class="col-sm-4 col-form-label py-1">Описание:</dt>
                    <dd class="col-sm-8 py-1">@Model.Book?.Description</dd>

                    <dt class="col-sm-4 col-form-label py-1">Создана:</dt>
                    <dd class="col-sm-8 py-1 small text-muted">@Model.Book?.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-4 col-form-label py-1">Обновлена:</dt>
                    <dd class="col-sm-8 py-1 small text-muted">@Model.Book?.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Панель: Оглавление -->
    <div class="tab-pane fade" id="pane-contents" role="tabpanel">
        <div class="card mb-3">
            <div class="card-header block-header">
                <span class="block-title">Оглавление</span>
            </div>
            <div class="card-body p-2" style="max-height: 400px; overflow-y: auto;">
                @if (Model.Chapters.Any())
                {
                    <ul class="list-group list-group-flush small" style="font-size: 0.85rem;">
                        @foreach (var chapter in Model.Chapters)
                        {
                            <li class="list-group-item px-2 py-1 border-0">
                                <strong>@chapter.Number.</strong> @chapter.Title
                                <br />
                                <small class="text-muted">с. @chapter.StartPage–@chapter.EndPage</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <em class="text-muted small">Оглавление отсутствует</em>
                }
            </div>
        </div>
    </div>

</div>

<!-- Кнопки действий: один комплект на все размеры экрана -->
<div class="d-flex gap-2 mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Book?.Id" class="btn btn-warning btn-sm">✏️ Редактировать</a>
    <a asp-page="Delete" asp-route-id="@Model.Book?.Id" class="btn btn-danger btn-sm">🗑 Удалить</a>
</div>