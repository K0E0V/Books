@page "{id:int}"
@model Books.Pages.Books.EditModel
@{
    ViewData["Title"] = $"Редактирование: {Model.Book.Title}";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/isbn-mask.js" asp-append-version="true"></script>
    <script src="~/js/form-scroll.js" asp-append-version="true"></script>
    <script src="~/js/form-tabs.js" asp-append-version="true"></script>
}

<h1 class="h4 mb-3">Редактирование книги</h1>

<form method="post" id="bookForm" class="book-form" data-keep-scroll>
    <input type="hidden" asp-for="Book.Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

    <!-- Закладки: видны только на мобильных. На десктопе обе панели рядом -->
    <ul class="nav nav-tabs d-lg-none mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" type="button" role="tab"
                    data-bs-toggle="tab" data-bs-target="#pane-requisites">
                Реквизиты
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" type="button" role="tab"
                    data-bs-toggle="tab" data-bs-target="#pane-contents">
                Оглавление
            </button>
        </li>
    </ul>

    <div class="tab-content blocks-tabs">

        <!-- Панель: Реквизиты книги -->
        <div class="tab-pane fade show active pane-wide" id="pane-requisites" role="tabpanel">
            <div class="card mb-3">
                <div class="card-header block-header">
                    <span class="block-title">Реквизиты книги</span>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <label asp-for="Book.Title" class="col-sm-4 col-form-label">Название *</label>
                        <div class="col-sm-8">
                            <input asp-for="Book.Title" class="form-control" required />
                            <span asp-validation-for="Book.Title" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Book.Author" class="col-sm-4 col-form-label">Автор *</label>
                        <div class="col-sm-8">
                            <input asp-for="Book.Author" class="form-control" required />
                            <span asp-validation-for="Book.Author" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Book.PublicationYear" class="col-sm-4 col-form-label">Год издания *</label>
                        <div class="col-sm-8">
                            <input asp-for="Book.PublicationYear" type="number" class="form-control"
                                   min="1000" max="2100" required />
                            <span asp-validation-for="Book.PublicationYear" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Book.Isbn" class="col-sm-4 col-form-label">ISBN *</label>
                        <div class="col-sm-8">
                            <input asp-for="Book.Isbn"
                                   class="form-control"
                                   placeholder="000-0-000-00000-0"
                                   maxlength="17"
                                   inputmode="numeric"
                                   data-isbn-mask
                                   required />
                            <span asp-validation-for="Book.Isbn" class="text-danger"></span>
                            <small class="form-text text-muted">
                                13 цифр, дефисы расставляются автоматически.
                            </small>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Book.Description" class="col-sm-4 col-form-label">Описание</label>
                        <div class="col-sm-8">
                            <textarea asp-for="Book.Description" rows="3" class="form-control"></textarea>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Book.CountPages" class="col-sm-4 col-form-label">Количество страниц *</label>
                        <div class="col-sm-8">
                            <input asp-for="Book.CountPages" type="number" class="form-control" min="1" required />
                            <span asp-validation-for="Book.CountPages" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Издательство *</label>
                        <div class="col-sm-8">
                            <input asp-for="Book.Publisher" class="form-control" list="publishersDatalist" required />
                            <datalist id="publishersDatalist">
                                @foreach (var p in Model.Publishers)
                                {
                                    <option value="@p.Name"></option>
                                }
                            </datalist>
                            <span asp-validation-for="Book.Publisher" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Жанры</label>
                        <div class="col-sm-8">
                            <select asp-for="Book.GenreIds" class="form-select" multiple size="5"
                                    asp-items="@(new SelectList(Model.Genres, "Id", "Name"))"></select>
                            <small class="text-muted">Выбор нескольких — Ctrl/Cmd + клик.</small>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Типы книги</label>
                        <div class="col-sm-8">
                            <select asp-for="Book.BookTypeIds" class="form-select" multiple size="5"
                                    asp-items="@(new SelectList(Model.BookTypes, "Id", "Name"))"></select>
                            <small class="text-muted">Выбор нескольких — Ctrl/Cmd + клик.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Панель: Оглавление -->
        <div class="tab-pane fade" id="pane-contents" role="tabpanel">
            <div class="card mb-3">
                <div class="card-header block-header">
                    <span class="block-title">Оглавление</span>
                </div>
                <div class="card-body p-2" style="max-height: 500px; overflow-y: auto;">
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm small mb-2">
                            <thead>
                                <tr>
                                    <th style="width: 2rem;">№</th>
                                    <th>Название</th>
                                    <th style="width: 5.6rem;">С</th>
                                    <th style="width: 5.6rem;">По</th>
                                    <th style="width: 2.5rem;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Chapters.Count; i++)
                                {
                                    <tr>
                                        <td class="align-middle">@(i + 1)</td>
                                        <td>
                                            <input asp-for="Chapters[i].Title" class="form-control form-control-sm" />
                                            <span asp-validation-for="Chapters[i].Title" class="text-danger small"></span>
                                        </td>
                                        <td>
                                            <input asp-for="Chapters[i].StartPage" type="number" min="1"
                                                   class="form-control form-control-sm page-number-input" />
                                            <span asp-validation-for="Chapters[i].StartPage" class="text-danger small"></span>
                                        </td>
                                        <td>
                                            <input asp-for="Chapters[i].EndPage" type="number" min="1"
                                                   class="form-control form-control-sm page-number-input" />
                                            <span asp-validation-for="Chapters[i].EndPage" class="text-danger small"></span>
                                        </td>
                                        <td>
                                            <button type="submit" asp-page-handler="RemoveChapter" asp-route-index="@i"
                                                    formnovalidate class="btn btn-sm btn-danger" title="Удалить главу">×</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="submit" asp-page-handler="AddChapter" formnovalidate
                            class="btn btn-sm btn-primary w-100">
                        + Добавить главу
                    </button>
                </div>
            </div>
        </div>

    </div>

    <div class="d-flex gap-2">
        <button type="submit" asp-page-handler="Save" class="btn btn-primary">
            Сохранить книгу
        </button>
        <a asp-page="Details" asp-route-id="@Model.Book.Id" class="btn btn-secondary">Отмена</a>
    </div>
</form>