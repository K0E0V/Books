@page "{id:int}"
@model Books.Pages.Books.EditModel
@{
    ViewData["Title"] = $"Редактирование: {Model.Book.Title}";
}

<h1>Редактировать книгу</h1>

<form method="post">@* 
    <input type="hidden" asp-for="Book.Id" />
 *@
<div class="card mb-3">
    <div class="card-header"><strong>Реквизиты книги</strong></div>
    <div class="card-body">
        <input type="hidden" asp-for="Book.Id" />
        <div class="mb-3">
            <label asp-for="Book.Title" class="form-label">Название *</label>
            <input asp-for="Book.Title" class="form-control" required />
            <span asp-validation-for="Book.Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Book.Author" class="form-label">Автор *</label>
            <input asp-for="Book.Author" class="form-control" required />
            <span asp-validation-for="Book.Author" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Book.PublicationYear" class="form-label">Год издания *</label>
            <input asp-for="Book.PublicationYear" type="number" class="form-control"
                   min="1000" max="2100" required />
            <span asp-validation-for="Book.PublicationYear" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Book.Isbn" class="form-label">ISBN</label>
            <input asp-for="Book.Isbn" class="form-control" />
            <span asp-validation-for="Book.Isbn" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Book.Publisher" class="form-label">Издатель</label>
            <input asp-for="Book.Publisher" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Book.Description" class="form-label">Описание</label>
            <textarea asp-for="Book.Description" rows="4" class="form-control"></textarea>
        </div>
    </div>
</div>



    <!-- Таблица глав -->
    <div class="card mb-3">
        <div class="card-header">Оглавление</div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Название</th>
                        <th>Стр. с</th>
                        <th>Стр. по</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Chapters.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td><input asp-for="Chapters[i].Title" class="form-control" /></td>
                            <td><input asp-for="Chapters[i].StartPage" type="number" class="form-control" /></td>
                            <td><input asp-for="Chapters[i].EndPage" type="number" class="form-control" /></td>
                            <td>
                                <button type="submit" asp-page-handler="RemoveChapter"
                                asp-route-index="@i" class="btn btn-sm btn-danger">Удалить</button>
                            </td>
                        </tr>            
                    }
                </tbody>
            </table>
            
            <button type="submit" asp-page-handler="AddChapter" class="btn btn-sm btn-primary">
                + Добавить главу
            </button>
        </div>
    </div>

    <button type="submit" asp-page-handler="Save" class="btn btn-primary">
        Сохранить книгу
    </button>
    <a asp-page="Details" asp-route-id="@Model.Book.Id" class="btn btn-secondary">Отмена</a>
</form>