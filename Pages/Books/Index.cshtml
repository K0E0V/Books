@page
@model Books.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Список книг";
}

<h1 class="h3" id="catalog">Каталог книг</h1>

<!-- Форма поиска и фильтров -->
<form method="get" class="mb-3">
    @* Сохраняем сортировку при фильтрации *@
    <input type="hidden" name="sortBy" value="@Model.SortBy" />
    <input type="hidden" name="sortDesc" value="@(Model.SortDesc ? "true" : "")" />

    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small mb-1" for="search">Поиск</label>
            <div class="input-group">
                <input id="search" type="text" name="search" value="@Model.Search"
                       class="form-control form-control-sm"
                       placeholder="Название, автор или оглавление..." />
                <button type="submit" class="btn btn-primary btn-sm">Найти</button>
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" asp-for="GenreId">Жанр</label>
            <select asp-for="GenreId" class="form-select form-select-sm" name="genreId"
                    asp-items="@(new SelectList(Model.Genres, "Id", "Name"))">
                <option value="">— все жанры —</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" asp-for="TypeId">Тип</label>
            <select asp-for="TypeId" class="form-select form-select-sm" name="typeId"
                    asp-items="@(new SelectList(Model.BookTypes, "Id", "Name"))">
                <option value="">— все типы —</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" asp-for="Author">Автор</label>
            <select asp-for="Author" class="form-select form-select-sm" name="author"
                    asp-items="@(new SelectList(Model.Authors))">
                <option value="">— все авторы —</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" asp-for="Year">Год</label>
            <select asp-for="Year" class="form-select form-select-sm" name="year"
                    asp-items="@(new SelectList(Model.Years))">
                <option value="">— все годы —</option>
            </select>
        </div>
    </div>
    <div class="mt-2">
        <a asp-page="Index" class="btn btn-secondary btn-sm">Сбросить фильтры</a>
    </div>
</form>

<!-- Кнопка создания -->
<div class="mb-3">
    <a asp-page="Create" class="btn btn-success">+ Добавить книгу</a>
</div>

@if (Model.Books.Any())
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th><a href="@Model.SortLink("id")" class="text-decoration-none">ID @(Model.SortBy == "id" ? (Model.SortDesc ? "▼" : "▲") : "")</a></th>
                <th><a href="@Model.SortLink("title")" class="text-decoration-none">Название @(Model.SortBy == "title" ? (Model.SortDesc ? "▼" : "▲") : "")</a></th>
                <th><a href="@Model.SortLink("author")" class="text-decoration-none">Автор @(Model.SortBy == "author" ? (Model.SortDesc ? "▼" : "▲") : "")</a></th>
                <th><a href="@Model.SortLink("year")" class="text-decoration-none">Год @(Model.SortBy == "year" ? (Model.SortDesc ? "▼" : "▲") : "")</a></th>
                <th><a href="@Model.SortLink("pages")" class="text-decoration-none">Страниц @(Model.SortBy == "pages" ? (Model.SortDesc ? "▼" : "▲") : "")</a></th>
                <th>Жанры</th>
                <th>Типы</th>
                <th>ISBN</th>
                <th>Издатель</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr style="cursor: pointer;"
                    onmouseover="this.classList.add('table-active')"
                    onmouseout="this.classList.remove('table-active')"
                    onclick="window.location.href='@Url.Page("Details", new { id = book.Id })'">
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublicationYear</td>
                    <td>@book.CountPages</td>
                    <td>
                        @if (book.Genres.Any())
                        {
                            foreach (var g in book.Genres)
                            {
                                <span class="badge text-bg-secondary me-1">@g</span>
                            }
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </td>
                    <td>
                        @if (book.BookTypes.Any())
                        {
                            foreach (var t in book.BookTypes)
                            {
                                <span class="badge text-bg-info me-1">@t</span>
                            }
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </td>
                    <td>@(book.Isbn ?? "—")</td>
                    <td>@(book.Publisher ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Пагинация (сохраняет фильтры и сортировку) -->
    <nav>
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Model.Href(Model.CurrentPage - 1)">← Назад</a>
                </li>
            }

            <li class="page-item disabled">
                <span class="page-link">Страница @Model.CurrentPage из @Math.Ceiling((double)Model.TotalCount / Model.PageSize)</span>
            </li>

            @if (Model.CurrentPage * Model.PageSize < Model.TotalCount)
            {
                <li class="page-item">
                    <a class="page-link" href="@Model.Href(Model.CurrentPage + 1)">Вперёд →</a>
                </li>
            }
        </ul>
    </nav>
}
else
{
    <div class="alert alert-info">
        @(string.IsNullOrEmpty(Model.Search) && Model.GenreId == null && Model.TypeId == null && Model.Year == null && string.IsNullOrEmpty(Model.Author)
            ? "Книги не найдены. Добавьте первую книгу!"
            : "По заданным фильтрам ничего не найдено.")
    </div>
}
