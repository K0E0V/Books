@page
@model Books.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Список книг";
}

<h1>Каталог книг</h1>

<!-- Форма поиска -->
<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@Model.SearchTerm"
               class="form-control" placeholder="Поиск по названию, автору или оглавлению..." />
        <button type="submit" class="btn btn-primary">Найти</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="Index" class="btn btn-secondary">Сбросить</a>
        }
    </div>
</form>

<!-- Кнопка создания -->
<div class="mb-3">
    <a asp-page="Create" class="btn btn-success">+ Добавить книгу</a>
</div>

@if (Model.Books.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Автор</th>
                <th>Год</th>
                <th>ISBN</th>
                <th>Издатель</th>
                <th style="width: 200px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublicationYear</td>
                    <td>@(book.Isbn ?? "—")</td>
                    <td>@(book.Publisher ?? "—")</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-info">👁</a>
                        <a asp-page="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-warning">✏️</a>
                        <a asp-page="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">🗑</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Пагинация -->
    <nav>
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm">← Назад</a>
                </li>
            }

            <li class="page-item disabled">
                <span class="page-link">Страница @Model.CurrentPage из @Math.Ceiling((double)Model.TotalCount / Model.PageSize)</span>
            </li>

            @if (Model.CurrentPage * Model.PageSize < Model.TotalCount)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm">Вперёд →</a>
                </li>
            }
        </ul>
    </nav>
}
else
{
    <div class="alert alert-info">
        @(string.IsNullOrEmpty(Model.SearchTerm) ? "Книги не найдены. Добавьте первую книгу!" : "По вашему запросу ничего не найдено.")
    </div>
}