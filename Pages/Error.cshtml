@page
@model Books.Pages.ErrorModel
@{
    ViewData["Title"] = "Ошибка";
    var title = Model.ErrorCode.HasValue
        ? $"Произошла ошибка (код {Model.ErrorCode})"
        : "Произошла ошибка";
}




<div class="container mt-4">
    <h1 class="text-danger">Произошла ошибка@codeText</h1>
    <p class="lead">
        Извините, что-то пошло не так. Подробности записаны в лог.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">
            Идентификатор запроса: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-page="/Books/Index" class="btn btn-primary mt-3">
        Вернуться к списку книг
    </a>
</div>